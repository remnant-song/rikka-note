{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rikka-note",
  "version": "1.0.6",
  "identifier": "com.RemnantSong.rikka-note",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rikka-note",
        "label": "main",
        "width": 800,
        "height": 600,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob: asset: http://asset.localhost ipc: http://ipc.localhost; connect-src * ipc: http://ipc.localhost; img-src * data: blob: asset: http://asset.localhost; style-src * 'unsafe-inline'; font-src * data:; script-src * 'unsafe-inline' 'unsafe-eval';",
      "devCsp": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob: asset: http://asset.localhost ipc: http://ipc.localhost; connect-src * ipc: http://ipc.localhost; img-src * data: blob: asset: http://asset.localhost; style-src * 'unsafe-inline'; font-src * data:; script-src * 'unsafe-inline' 'unsafe-eval';",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ]
      },
      "wix": {
        "language": [
          "zh-CN"
        ]
      }
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "bin/win64/*.dll": "./"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCNDc1RTVGQjM0NDA1NTEKUldSUkJVU3pYMTVIMnhpQitndkVpMXNEUWpidi9xN1JkMEc2RUUyOTB6a0VSdEVtUjB0S0NxLzUK",
      "endpoints": [
        "https://github.com/remnant-song/rikka-note/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
