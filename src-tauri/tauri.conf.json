{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rikka-note",
  "version": "1.0.2",
  "identifier": "com.RemnantSong.rikka-note",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rikka-note",
        "label": "main",
        "width": 800,
        "height": 600,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://* http://localhost:* http://127.0.0.1:*",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://s2.loli.net https://*",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com",
        "font-src": "'self' https://fonts.gstatic.com https://unpkg.com data:",
        "script-src": "'self' 'unsafe-eval' https://unpkg.com"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://* http://localhost:* http://127.0.0.1:*",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://s2.loli.net https://*",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com",
        "font-src": "'self' https://fonts.gstatic.com https://unpkg.com data:",
        "script-src": "'self' 'unsafe-eval' 'unsafe-inline' https://unpkg.com"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ]
      },
      "wix": {
        "language": [
          "zh-CN"
        ]
      }
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "bin/win64/*.dll": "./"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCNDc1RTVGQjM0NDA1NTEKUldSUkJVU3pYMTVIMnhpQitndkVpMXNEUWpidi9xN1JkMEc2RUUyOTB6a0VSdEVtUjB0S0NxLzUK",
      "endpoints": [
        "https://github.com/remnant-song/rikka-note/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
